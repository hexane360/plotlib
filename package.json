{
  "name": "@hexane/plotlib",
  "version": "0.2.0",
  "description": "A React component library for building interactive scientific figures.",
  "license": "MIT",
  "author": "Colin Gilgenbach <colin@gilgenbach.net>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hexane360/plotlib.git"
  },
  "bugs": {
    "url": "https://github.com/hexane360/plotlib/issues"
  },
  "keywords": [
    "react",
    "plot",
    "chart",
    "figure",
    "visualization",
    "scientific",
    "svg"
  ],
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./*": {
      "default": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "scripts": {
    "test": "vitest",
    "test-unit": "vitest --project=unit",
    "test-storybook": "vitest --project=storybook",
    "build": "tsx scripts/build",
    "watch": "tsx scripts/watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "fs-extra": "^11.3.3",
    "hash-css-selector": "^1.1.0",
    "jotai": "^2.18.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "rollup": "^4.52.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18",
    "zx": "^8.8.5"
  },
  "dependencies": {
    "@lume/kiwi": "^0.4.4",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-format": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-scale-chromatic": "^3.1.0"
  },
  "peerDependencies": {
    "jotai": "^2.15.0",
    "react": "^19.2.2",
    "react-dom": "^19.2.2"
  }
}
